# انسخ هذا الملف إلى .env وعدّل القيم
DOMAIN=app.example.com
PORT=3000
SESSION_SECRET=ضع-نصاً-عشوائياً-طويلاً
SECURE_COOKIES=1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=غيّرني

# اتصال MQTT (داخل docker-compose يكون العنوان mqtt://mosquitto:1883)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=dashboard
MQTT_PASSWORD=

# المواضيع: عدّلها حسب ملفات المصنع. + = الرقم التسلسلي للكاميرا
MQTT_TOPIC_RESULT=device/+/result
MQTT_TOPIC_HEARTBEAT=device/+/heartbeat
MQTT_TOPIC_COMMAND=device/{serial}/command
MQTT_OPEN_GATE_PAYLOAD={"cmd":"open_gate","serialno":"{serial}","id":"{id}","ts":{ts}}

DEVICE_OFFLINE_AFTER_SEC=120
KEEP_READS_DAYS=90
