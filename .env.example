# ======== أراكم — إعدادات الإنتاج ========
# انسخ هذا الملف إلى .env (سكربت deploy/setup.sh يفعل ذلك تلقائياً)
NODE_ENV=production
TZ_NAME=Asia/Riyadh

# النطاقان (يجب أن يشيرا إلى عنوان IP السيرفر)
ADMIN_HOST=admin.arakom.sa
APP_HOST=app.arakom.sa

# أسرار — يولدها سكربت الإعداد
SESSION_SECRET=
POSTGRES_PASSWORD=

# أول حساب للإدارة العليا (يُنشأ عند أول تشغيل فقط)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# اتصال الخادم بـ Mosquitto
MQTT_USERNAME=arakom-backend
MQTT_PASSWORD=
MQTT_CLIENT_ID=arakom-backend
# موضوع أوامر الفتح الموحد، والإرسال المباشر لأمر iooutput للكاميرا (1 = نعم)
MQTT_GATE_COMMAND_TOPIC=arakom/gates/{gate_id}/command
MQTT_SEND_CAMERA_IO=1
CAMERA_OFFLINE_AFTER_SEC=90

# البريد لإرسال رموز الدخول (اختياري — بدونه يدخل العملاء بكلمة المرور فقط)
# مثال Google Workspace: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 + كلمة مرور تطبيق
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=أراكم <no-reply@arakom.sa>

# متجر سلة
SALLA_WEBHOOK_SECRET=
# تطبيق أراكم في بوابة شركاء سلة (للتحقق من أن العميل مسجل في المتجر)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# رابط متجر أراكم (يظهر لمن يحاول الدخول وهو غير مسجل في المتجر)
SALLA_STORE_URL=https://arakom-store.com/ar
# 1 = لا يدخل العملاء إلا بحساب مسجل في متجر أراكم
STORE_LOGIN_ONLY=1

# الاحتفاظ بالبيانات
KEEP_LOGS_DAYS=180
KEEP_IMAGES_DAYS=60
