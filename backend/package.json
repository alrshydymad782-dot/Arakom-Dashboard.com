{
  "name": "arakom-backend",
  "version": "2.0.0",
  "private": true,
  "description": "أراكم - الخادم: API + MQTT + Socket.io",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
